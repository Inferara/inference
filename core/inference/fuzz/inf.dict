# libFuzzer dictionary for the `front_end` and `compile` targets: the tokens of
# the Inference language, so mutations splice whole keywords and operators into
# a source instead of growing them byte by byte. The keywords are the lexer's
# (`SyntaxKind::from_keyword` in core/parser/src/syntax_kind.rs), the operators
# its multi-byte punctuation; `string` and `host` are identifiers the type
# checker gives a meaning.

kw_fn="fn"
kw_let="let"
kw_mut="mut"
kw_spec="spec"
kw_struct="struct"
kw_enum="enum"
kw_const="const"
kw_type="type"
kw_external="external"
kw_return="return"
kw_loop="loop"
kw_if="if"
kw_else="else"
kw_assert="assert"
kw_break="break"
kw_use="use"
kw_from="from"
kw_self="self"
kw_pub="pub"
kw_assume="assume"
kw_forall="forall"
kw_exists="exists"
kw_unique="unique"
kw_checked="checked"
kw_wrapping="wrapping"
kw_i8="i8"
kw_i16="i16"
kw_i32="i32"
kw_i64="i64"
kw_u8="u8"
kw_u16="u16"
kw_u32="u32"
kw_u64="u64"
kw_bool="bool"
kw_unit="unit"
kw_true="true"
kw_false="false"
id_string="string"
id_host="host::"

op_path="::"
op_arrow="->"
op_pow="**"
op_and="&&"
op_or="||"
op_shl="<<"
op_shr=">>"
op_le="<="
op_ge=">="
op_eq="=="
op_ne="!="
op_uzumaki="@"
op_unit="()"
