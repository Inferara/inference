// A spec whose `unique` block draws no value of its own. With nothing to
// single out, the block claims no uniqueness, so a proof-mode build (`-v`)
// fails with a fatal `P020` diagnostic surfaced on stderr. (A compile-mode
// build strips the proof-only spec and succeeds; proof mode is the only mode
// that translates spec obligations.)
pub fn main() -> i32 {
    return 0;
}

spec UniqueFeature {
    fn only_unique() {
        unique {
            const a: i32 = 42;
        }
    }
}
