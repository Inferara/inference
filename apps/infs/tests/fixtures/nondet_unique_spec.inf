// A `unique`-BODIED spec function (`fn f() unique { … }`). The nested `unique`
// block in `nondet_unique.inf` stays a fatal P002; a unique BODY is
// reachability-lowered exactly like an exists one, and its obligation selects
// the `ValidUniqueSpec` theorem in the `.v`. The `assume` pins the named
// choice to one value, so exactly one choice survives — the shape the unique
// judgment states. A compile-mode build strips the proof-only spec.
pub fn main() -> i32 {
    return 0;
}

spec UqDemo {
    fn uq_witness() unique {
        let n: i32 = @;
        assume {
            assert(n == 7);
        }
        assert(n > 0);
    }
}
