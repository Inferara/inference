// A spec exercising the TRANSLATABLE non-deterministic constructs: a `forall`
// body with the uzumaki `@`, an `assume` filter, and a nested `exists` block.
// Non-deterministic constructs are valid only inside a spec declaration.
//
// A proof-mode build (`-v`) lowers the `forall`/`@`/`assume`/`exists` to the
// custom WASM opcodes AND emits the spec's `hassert` obligation into the Rocq
// `.v` (the spec function itself is omitted from the module record). A
// compile-mode build strips the proof-only spec and emits only the executable
// `main`.
//
// A `unique` block is covered apart from these: `nondet_unique.inf` and
// `nondet_unique_arm.inf` hold the two shapes a proof-mode build refuses.
pub fn main() -> i32 {
    return 0;
}

spec NonDetFeatures {
    fn features() forall {
        let n: i32 = @;
        assume {
            assert(n > 0);
        }
        exists {
            let m: i32 = @;
            assert(m == n);
        }
    }
}
