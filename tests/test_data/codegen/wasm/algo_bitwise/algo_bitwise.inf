fn popcount_helper(n: i32, acc: i32) -> i32 {
    if n == 0 {
        return acc;
    }
    return popcount_helper(n & (n - 1), acc + 1);
}

pub fn popcount(n: i32) -> i32 {
    return popcount_helper(n, 0);
}

pub fn is_power_of_2(n: i32) -> bool {
    if n <= 0 {
        return false;
    }
    return (n & (n - 1)) == 0;
}

pub fn get_bit(x: i32, pos: i32) -> i32 {
    return (x >> pos) & 1;
}

pub fn set_bit(x: i32, pos: i32) -> i32 {
    return x | (1 << pos);
}

pub fn clear_bit(x: i32, pos: i32) -> i32 {
    return x & (~(1 << pos));
}

pub fn toggle_bit(x: i32, pos: i32) -> i32 {
    return x ^ (1 << pos);
}

pub fn lowest_set_bit(n: i32) -> i32 {
    return n & (-n);
}

pub fn rotate_left_8(x: i32, r: i32) -> i32 {
    let shift: i32 = r & 7;
    return ((x << shift) | (x >> (8 - shift))) & 255;
}

fn clz_helper(n: i32, bit: i32, count: i32) -> i32 {
    if bit < 0 {
        return count;
    }
    if ((n >> bit) & 1) == 1 {
        return count;
    }
    return clz_helper(n, bit - 1, count + 1);
}

pub fn count_leading_zeros(n: i32) -> i32 {
    if n == 0 {
        return 32;
    }
    return clz_helper(n, 31, 0);
}

pub fn byte_swap_16(x: i32) -> i32 {
    let lo: i32 = x & 255;
    let hi: i32 = (x >> 8) & 255;
    return (lo << 8) | hi;
}
