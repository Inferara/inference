pub fn popcount(n: i32) -> i32 {
    let mut count: i32 = 0;
    let mut x: i32 = n;
    loop x != 0 {
        x = x & (x - 1);
        count = count + 1;
    }
    return count;
}

pub fn is_power_of_2(n: i32) -> bool {
    if n <= 0 {
        return false;
    }
    return (n & (n - 1)) == 0;
}

pub fn get_bit(x: i32, pos: i32) -> i32 {
    return (x >> pos) & 1;
}

pub fn set_bit(x: i32, pos: i32) -> i32 {
    return x | (1 << pos);
}

pub fn clear_bit(x: i32, pos: i32) -> i32 {
    return x & (~(1 << pos));
}

pub fn toggle_bit(x: i32, pos: i32) -> i32 {
    return x ^ (1 << pos);
}

pub fn lowest_set_bit(n: i32) -> i32 {
    return n & (-n);
}

pub fn rotate_left_8(x: i32, r: i32) -> i32 {
    let shift: i32 = r & 7;
    return ((x << shift) | (x >> (8 - shift))) & 255;
}

pub fn count_leading_zeros(n: i32) -> i32 {
    if n == 0 {
        return 32;
    }
    let mut count: i32 = 0;
    let mut bit: i32 = 31;
    loop ((n >> bit) & 1) == 0 {
        count = count + 1;
        bit = bit - 1;
    }
    return count;
}

pub fn byte_swap_16(x: i32) -> i32 {
    let lo: i32 = x & 255;
    let hi: i32 = (x >> 8) & 255;
    return (lo << 8) | hi;
}
