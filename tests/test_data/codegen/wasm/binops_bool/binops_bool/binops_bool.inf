pub fn and3(a: bool, b: bool, c: bool) -> bool { return a && b && c; }
pub fn or3(a: bool, b: bool, c: bool) -> bool { return a || b || c; }
pub fn and_or(a: bool, b: bool, c: bool) -> bool { return (a && b) || c; }
pub fn or_and(a: bool, b: bool, c: bool) -> bool { return a || (b && c); }
pub fn not_and_or(a: bool, b: bool, c: bool) -> bool { return !a && (b || c); }
pub fn de_morgan_and(a: bool, b: bool) -> bool { return !(a && b); }
pub fn de_morgan_or(a: bool, b: bool) -> bool { return !(a || b); }
pub fn cmp_and_cmp(a: i32, b: i32, c: i32, d: i32) -> bool { return (a < b) && (c < d); }
pub fn cmp_or_cmp(a: i32, b: i32, c: i32, d: i32) -> bool { return (a > b) || (c > d); }
pub fn between(x: i32, lo: i32, hi: i32) -> bool { return (x >= lo) && (x <= hi); }
pub fn not_between(x: i32, lo: i32, hi: i32) -> bool { return (x < lo) || (x > hi); }
pub fn all_same_sign(a: i32, b: i32) -> bool { return (a >= 0) == (b >= 0); }
pub fn xor_bool(a: bool, b: bool) -> bool { return (a || b) && !(a && b); }
pub fn implies(a: bool, b: bool) -> bool { return !a || b; }
pub fn bool_majority3(a: bool, b: bool, c: bool) -> bool { return (a && b) || (b && c) || (a && c); }
