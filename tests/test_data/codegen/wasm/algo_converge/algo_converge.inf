fn slow_div_helper(a: i32, b: i32, acc: i32) -> i32 {
    if a < b {
        return acc;
    }
    return slow_div_helper(a - b, b, acc + 1);
}

pub fn slow_div(a: i32, b: i32) -> i32 {
    return slow_div_helper(a, b, 0);
}

fn slow_mod_helper(a: i32, b: i32) -> i32 {
    if a < b {
        return a;
    }
    return slow_mod_helper(a - b, b);
}

pub fn slow_mod(a: i32, b: i32) -> i32 {
    return slow_mod_helper(a, b);
}

fn peasant_mul_helper(a: i32, b: i32, acc: i32) -> i32 {
    if a <= 0 {
        return acc;
    }
    if (a & 1) == 1 {
        return peasant_mul_helper(a >> 1, b << 1, acc + b);
    }
    return peasant_mul_helper(a >> 1, b << 1, acc);
}

pub fn peasant_mul(a: i32, b: i32) -> i32 {
    return peasant_mul_helper(a, b, 0);
}

fn is_prime_helper(n: i32, d: i32) -> bool {
    if d * d > n {
        return true;
    }
    if (n % d) == 0 {
        return false;
    }
    return is_prime_helper(n, d + 1);
}

pub fn is_prime(n: i32) -> bool {
    if n <= 1 {
        return false;
    }
    if n <= 3 {
        return true;
    }
    return is_prime_helper(n, 2);
}

pub fn collatz_steps(n: i32) -> i32 {
    if n <= 1 {
        return 0;
    }
    if (n & 1) == 0 {
        return 1 + collatz_steps(n >> 1);
    }
    return 1 + collatz_steps(3 * n + 1);
}

pub fn collatz_max(n: i32) -> i32 {
    if n <= 1 {
        return n;
    }
    if (n & 1) == 0 {
        let next: i32 = collatz_max(n >> 1);
        if next > n {
            return next;
        }
        return n;
    }
    let next_odd: i32 = collatz_max(3 * n + 1);
    if next_odd > n {
        return next_odd;
    }
    return n;
}

pub fn spec_division() {
    forall {
        let a: i32 = @;
        let b: i32 = @;
        assume {
            let check: bool = b > 0;
        }
    }
}
