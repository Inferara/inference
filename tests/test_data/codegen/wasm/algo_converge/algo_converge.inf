pub fn slow_div(a: i32, b: i32) -> i32 {
    let mut acc: i32 = 0;
    let mut x: i32 = a;
    loop x >= b {
        x = x - b;
        acc = acc + 1;
    }
    return acc;
}

pub fn slow_mod(a: i32, b: i32) -> i32 {
    let mut x: i32 = a;
    loop x >= b {
        x = x - b;
    }
    return x;
}

pub fn peasant_mul(a: i32, b: i32) -> i32 {
    let mut acc: i32 = 0;
    let mut x: i32 = a;
    let mut y: i32 = b;
    loop x > 0 {
        if (x & 1) == 1 {
            acc = acc + y;
        }
        x = x >> 1;
        y = y << 1;
    }
    return acc;
}

pub fn is_prime(n: i32) -> bool {
    if n <= 1 {
        return false;
    }
    let mut result: bool = true;
    let mut d: i32 = 2;
    loop d * d <= n {
        if (n % d) == 0 {
            result = false;
            break;
        }
        d = d + 1;
    }
    return result;
}

pub fn collatz_steps(n: i32) -> i32 {
    if n <= 1 {
        return 0;
    }
    let mut steps: i32 = 0;
    let mut x: i32 = n;
    loop x > 1 {
        if (x & 1) == 0 {
            x = x >> 1;
        } else {
            x = 3 * x + 1;
        }
        steps = steps + 1;
    }
    return steps;
}

pub fn collatz_max(n: i32) -> i32 {
    if n <= 1 {
        return n;
    }
    let mut best: i32 = n;
    let mut x: i32 = n;
    loop x > 1 {
        if (x & 1) == 0 {
            x = x >> 1;
        } else {
            x = 3 * x + 1;
        }
        if x > best {
            best = x;
        }
    }
    return best;
}

pub fn spec_division() {
    forall {
        let a: i32 = @;
        let b: i32 = @;
        assume {
            let check: bool = b > 0;
        }
    }
}
