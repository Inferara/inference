// --- Group 1: Direct boolean parameters as conditions ---

pub fn if_bool_param(cond: bool) -> i32 {
    if cond {
        return 1;
    }
    return 0;
}

pub fn if_not_param(cond: bool) -> i32 {
    if !cond {
        return 1;
    }
    return 0;
}

// --- Group 2: Comparison + logical ops as conditions ---

pub fn if_and(x: i32, y: i32) -> i32 {
    if (x > 0) && (y > 0) {
        return 1;
    }
    return 0;
}

pub fn if_or(x: i32, y: i32) -> i32 {
    if (x > 0) || (y > 0) {
        return 1;
    }
    return 0;
}

pub fn if_not_cmp(x: i32) -> i32 {
    if !(x > 0) {
        return 1;
    }
    return 0;
}

// --- Group 3: Complex nested boolean conditions ---

pub fn if_and_or(a: i32, b: i32, c: i32) -> i32 {
    if (a > 0) && ((b < 10) || (c == 0)) {
        return 1;
    }
    return 0;
}

pub fn if_or_and(a: i32, b: i32, c: i32) -> i32 {
    if (a > 0) || ((b > 0) && (c > 0)) {
        return 1;
    }
    return 0;
}

pub fn if_demorgan_and(a: bool, b: bool) -> i32 {
    if !(a && b) {
        return 1;
    } else {
        return 0;
    }
}

pub fn if_demorgan_or(a: bool, b: bool) -> i32 {
    if !(a || b) {
        return 1;
    } else {
        return 0;
    }
}

pub fn if_between(x: i32, lo: i32, hi: i32) -> i32 {
    if (x >= lo) && (x <= hi) {
        return 1;
    }
    return 0;
}

// --- Group 4: Boolean locals as conditions ---

pub fn if_bool_local(x: i32) -> i32 {
    let b: bool = x > 0;
    if b {
        return 1;
    }
    return 0;
}

pub fn if_bool_local_complex(x: i32, y: i32) -> i32 {
    let b: bool = (x > 0) && (y > 0);
    if b {
        return 1;
    }
    return 0;
}

// --- Group 5: Boolean equality/inequality in conditions ---

pub fn if_bool_eq(a: bool, b: bool) -> i32 {
    if a == b {
        return 1;
    } else {
        return 0;
    }
}

pub fn if_bool_ne(a: bool, b: bool) -> i32 {
    if a != b {
        return 1;
    } else {
        return 0;
    }
}

// --- Group 6: Boolean return from conditionals ---

pub fn cond_returns_bool(x: i32) -> bool {
    if x > 0 {
        return true;
    }
    return false;
}

// --- Group 7: If-else with complex condition and value-producing arms ---

pub fn if_else_complex(a: i32, b: i32) -> i32 {
    if (a > 0) && (b > 0) {
        return a;
    } else {
        return b;
    }
}
