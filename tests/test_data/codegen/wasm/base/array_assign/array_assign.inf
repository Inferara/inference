pub fn write_and_read() -> i32 {
    let mut arr: [i32; 3] = [0, 0, 0];
    arr[0] = 42;
    return arr[0];
}

pub fn write_multiple() -> i32 {
    let mut arr: [i32; 3] = [0, 0, 0];
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;
    return arr[0] + arr[1] + arr[2];
}

pub fn swap_elements() -> i32 {
    let mut arr: [i32; 2] = [1, 2];
    let tmp: i32 = arr[0];
    arr[0] = arr[1];
    arr[1] = tmp;
    return arr[0] * 10 + arr[1];
}

pub fn write_computed_index(i: i32) -> i32 {
    let mut arr: [i32; 3] = [0, 0, 0];
    arr[i + 1] = 99;
    return arr[2];
}

pub fn write_bool() -> i32 {
    let mut flags: [bool; 3] = [false, false, false];
    flags[0] = true;
    flags[2] = true;
    if flags[0] {
        if flags[2] {
            return 1;
        }
    }
    return 0;
}
