struct Inner { x: i32; y: i32; }
struct Outer { inner: Inner; val: i32;
    fn get_inner_x(self) -> i32 {
        let i: Inner = self.inner;
        return i.x;
    }
    fn sum_inner(self) -> i32 {
        let i: Inner = self.inner;
        return i.x + i.y;
    }
}

pub fn create_and_read_val() -> i32 {
    let o: Outer = Outer { inner: Inner { x: 10, y: 20 }, val: 30 };
    return o.val;
}

pub fn read_via_copy() -> i32 {
    let o: Outer = Outer { inner: Inner { x: 10, y: 20 }, val: 30 };
    let i: Inner = o.inner;
    return i.x;
}

pub fn read_inner_y_via_copy() -> i32 {
    let o: Outer = Outer { inner: Inner { x: 10, y: 20 }, val: 30 };
    let i: Inner = o.inner;
    return i.y;
}

pub fn sum_all_fields() -> i32 {
    let o: Outer = Outer { inner: Inner { x: 10, y: 20 }, val: 30 };
    let i: Inner = o.inner;
    let sum: i32 = i.x + i.y + o.val;
    return sum;
}

pub fn write_inner_field() -> i32 {
    let mut o: Outer = Outer { inner: Inner { x: 10, y: 20 }, val: 30 };
    let mut i: Inner = o.inner;
    i.x = 99;
    return i.x;
}

pub fn nested_struct_param(o: Outer) -> i32 {
    let i: Inner = o.inner;
    return i.x;
}

pub fn nested_struct_return() -> Outer {
    let o: Outer = Outer { inner: Inner { x: 42, y: 84 }, val: 126 };
    return o;
}

pub fn test_method_get_inner_x() -> i32 {
    let o: Outer = Outer { inner: Inner { x: 55, y: 66 }, val: 77 };
    return o.get_inner_x();
}

pub fn test_method_sum_inner() -> i32 {
    let o: Outer = Outer { inner: Inner { x: 10, y: 20 }, val: 30 };
    return o.sum_inner();
}
