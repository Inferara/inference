pub fn swap01() -> i32 {
    let mut a: [i32; 2] = [5, 9];
    a = [a[1], a[0]];
    return a[0] * 100 + a[1];
}

pub fn rotate3() -> i32 {
    let mut b: [i32; 3] = [1, 2, 3];
    b = [b[2], b[0], b[1]];
    return b[0] * 100 + b[1] * 10 + b[2];
}

pub fn swap01_i64() -> i64 {
    let mut c: [i64; 2] = [5, 9];
    c = [c[1], c[0]];
    let hundred: i64 = 100;
    return c[0] * hundred + c[1];
}
