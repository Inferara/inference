pub fn let_i32_literal() -> i32 {
    let x: i32 = 42;
    return x;
}

pub fn let_i64_literal() -> i64 {
    let y: i64 = -9223372036854775808;
    return y;
}

pub fn let_i8_literal() -> i8 {
    let a: i8 = -128;
    return a;
}

pub fn let_i16_literal() -> i16 {
    let b: i16 = -32768;
    return b;
}

pub fn let_u8_literal() -> u8 {
    let c: u8 = 255;
    return c;
}

pub fn let_u16_literal() -> u16 {
    let d: u16 = 65535;
    return d;
}

pub fn let_u32_literal() -> u32 {
    let e: u32 = 4294967295;
    return e;
}

pub fn let_u64_literal() -> u64 {
    let f: u64 = 18446744073709551615;
    return f;
}

pub fn let_bool_literal_true() -> bool {
    let flag: bool = true;
    return flag;
}

pub fn let_bool_literal_false() -> bool {
    let flag: bool = false;
    return flag;
}

pub fn let_from_identifier() -> i32 {
    let x: i32 = 10;
    let y: i32 = x;
    return y;
}
