pub fn read_first() -> i32 {
    let arr: [i32; 3] = [10, 20, 30];
    return arr[0];
}

pub fn read_last() -> i32 {
    let arr: [i32; 3] = [10, 20, 30];
    return arr[2];
}

pub fn read_middle() -> i32 {
    let arr: [i32; 3] = [10, 20, 30];
    return arr[1];
}

pub fn read_with_variable(i: i32) -> i32 {
    let arr: [i32; 3] = [100, 200, 300];
    return arr[i];
}

pub fn read_bool_true() -> i32 {
    let flags: [bool; 3] = [true, false, true];
    if flags[0] {
        return 1;
    }
    return 0;
}

pub fn read_bool_false() -> i32 {
    let flags: [bool; 3] = [true, false, true];
    if flags[1] {
        return 1;
    }
    return 0;
}
