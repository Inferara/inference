pub fn if_only(x: i32) -> i32 {
    if x > 0 {
        return 1;
    }
    return 0;
}

pub fn if_else_branch(x: i32) -> i32 {
    if x > 0 {
        return 1;
    } else {
        return 0;
    }
}

pub fn if_with_local(x: i32) -> i32 {
    if x > 0 {
        let r: i32 = x;
        return r;
    }
    return 0;
}

pub fn if_else_with_local(x: i32) -> i32 {
    if x > 0 {
        let a: i32 = x;
        return a;
    } else {
        let b: i32 = x;
        return b;
    }
}

pub fn nested_if(x: i32, y: i32) -> i32 {
    if x > 0 {
        if y > 0 {
            return 2;
        }
        return 1;
    }
    return 0;
}

pub fn if_void(x: i32) {
    if x > 0 {
        const ignored: i32 = 1;
    }
}
