struct Point {
    x: i32;
    y: i32;

    fn get_x(self) -> i32 {
        return self.x;
    }
    fn get_y(self) -> i32 {
        return self.y;
    }
}

struct Size {
    w: i32;
    h: i32;

    fn get_x(self) -> i32 {
        return self.w;
    }
    fn get_y(self) -> i32 {
        return self.h;
    }
}

pub fn test_point_get_x() -> i32 {
    let p: Point = Point { x: 10, y: 20 };
    return p.get_x();
}

pub fn test_size_get_x() -> i32 {
    let s: Size = Size { w: 30, h: 40 };
    return s.get_x();
}

pub fn test_both_get_y() -> i32 {
    let p: Point = Point { x: 1, y: 2 };
    let s: Size = Size { w: 3, h: 4 };
    return p.get_y() + s.get_y();
}
