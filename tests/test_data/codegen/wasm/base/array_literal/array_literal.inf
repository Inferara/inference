pub fn i32_array() -> i32 {
    let arr: [i32; 3] = [10, 20, 30];
    return 0;
}

pub fn bool_array() -> i32 {
    let flags: [bool; 4] = [true, false, true, false];
    return 0;
}

pub fn two_arrays() -> i32 {
    let a: [i32; 2] = [1, 2];
    let b: [i32; 2] = [3, 4];
    return 0;
}

pub fn single_element() -> i32 {
    let one: [i32; 1] = [42];
    return 0;
}
