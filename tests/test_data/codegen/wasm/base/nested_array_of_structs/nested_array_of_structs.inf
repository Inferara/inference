struct Pt { x: i32; y: i32; }

pub fn grid_2d_x() -> i32 {
    let g: [[Pt; 2]; 2] = [[Pt{x:1,y:2}, Pt{x:3,y:4}], [Pt{x:5,y:6}, Pt{x:7,y:8}]];
    return g[1][0].x;
}

pub fn grid_2d_y() -> i32 {
    let g: [[Pt; 2]; 2] = [[Pt{x:1,y:2}, Pt{x:3,y:4}], [Pt{x:5,y:6}, Pt{x:7,y:8}]];
    return g[0][1].y;
}

pub fn cube_3d() -> i32 {
    let c: [[[Pt; 1]; 2]; 2] = [[[Pt{x:10,y:11}], [Pt{x:12,y:13}]], [[Pt{x:14,y:15}], [Pt{x:16,y:17}]]];
    return c[1][0][0].y;
}

pub fn grid_nonliteral() -> i32 {
    let p: Pt = Pt{x:21,y:22};
    let g: [[Pt; 2]; 2] = [[p, p], [p, p]];
    return g[1][1].x + g[0][1].y;
}
