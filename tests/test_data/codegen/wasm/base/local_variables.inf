pub fn let_i32_literal() -> i32 {
    let x: i32 = 42;
    return x;
}

pub fn let_bool_literal_true() -> bool {
    let flag: bool = true;
    return flag;
}

pub fn let_bool_literal_false() -> bool {
    let flag: bool = false;
    return flag;
}

pub fn let_uzumaki_i32() -> i32 {
    let a: i32 = @;
    return a;
}

pub fn let_uzumaki_i64() -> i64 {
    let b: i64 = @;
    return b;
}

pub fn let_from_identifier() -> i32 {
    let x: i32 = 10;
    let y: i32 = x;
    return y;
}

pub fn let_i8_literal() -> i8 {
    let x: i8 = 100;
    return x;
}

pub fn let_i16_literal() -> i16 {
    let y: i16 = 1000;
    return y;
}

pub fn let_u8_literal() -> u8 {
    let z: u8 = 200;
    return z;
}

pub fn let_u16_literal() -> u16 {
    let w: u16 = 40000;
    return w;
}
