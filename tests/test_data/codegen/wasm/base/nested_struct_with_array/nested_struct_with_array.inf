struct HasArray {
    arr: [i32; 3];
    val: i32;
}

struct Deep {
    inner: HasArray;
    tag: i32;
}

pub fn test_deep_inner_arr_access() -> i32 {
    let ha: HasArray = HasArray { arr: [10, 20, 30], val: 99 };
    let d: Deep = Deep { inner: ha, tag: 42 };
    return d.inner.arr[1];
}

pub fn test_deep_inner_val() -> i32 {
    let ha: HasArray = HasArray { arr: [10, 20, 30], val: 99 };
    let d: Deep = Deep { inner: ha, tag: 42 };
    return d.inner.val;
}

pub fn test_deep_tag() -> i32 {
    let ha: HasArray = HasArray { arr: [10, 20, 30], val: 99 };
    let d: Deep = Deep { inner: ha, tag: 42 };
    return d.tag;
}

pub fn test_deep_inner_arr_sum() -> i32 {
    let ha: HasArray = HasArray { arr: [10, 20, 30], val: 99 };
    let d: Deep = Deep { inner: ha, tag: 42 };
    return d.inner.arr[0] + d.inner.arr[1] + d.inner.arr[2];
}

pub fn deep_param(d: Deep) -> i32 {
    return d.inner.arr[0] + d.tag;
}

pub fn deep_return() -> Deep {
    let ha: HasArray = HasArray{arr:[10,20,30],val:99};
    let d: Deep = Deep{inner:ha,tag:42};
    return d;
}
