// An escaping immutable `self` sharing a frame with a named compound parameter.
//
// The receiver slot is new; the parameter slots are not. Both are carved out of
// the same frame by the same offset accumulator, and the receiver is the first
// argument, so it takes offset 0 and pushes every parameter slot up by its own
// size. An off-by-one in that accounting — a receiver that claimed no space, or
// a parameter that kept the offset it had when the receiver was frameless —
// puts the two regions on top of each other, and the entry copies then overwrite
// one another.
//
// Nothing in the rest of the family can see that: every other escaping fixture
// has the receiver as its only frame occupant, so any offset at all works. This
// one reads both after the external has run, which a collision cannot survive.

external fn sort_pair(p: Pair);
use { sort_pair } from sortlib;

struct Pair {
    a: i32;
    b: i32;

    fn touch(self, extra: [i32; 4]) -> i32 {
        sort_pair(self);
        return self.a * 1000 + self.b * 100 + extra[0] * 10 + extra[3];
    }
}

pub fn run() -> i32 {
    let p: Pair = Pair { a: 5, b: 2 };
    let e: [i32; 4] = [1, 2, 3, 4];
    return p.touch(e) * 100 + p.a * 10 + p.b;
}
