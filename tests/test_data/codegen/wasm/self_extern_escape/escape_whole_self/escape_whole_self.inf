// A `self` receiver forwarded whole to an `external fn` declared to write
// through the parameter it lands on. A compound extern argument lowers to a raw
// pointer and linked modules share one linear memory, so the foreign body is
// handed an address inside the caller's struct. The receiver therefore needs its
// own frame slot and an entry copy.
//
// The copy is earned by the escape, not by `mut`: a `mut` receiver nothing can
// write through is still read in place. `mut self` is here because the
// declaration says `mut p`, and handing a binding the source did not declare
// mutable to a parameter the foreign body may write through is an A047 error.
// `read_only_extern_self` is the same shape against a declaration that marks
// nothing `mut`, where no copy is emitted at all.
//
// The `use` binding is load-bearing, not decoration: an `external fn` with no
// binding carries no origin, is skipped by import registration, and would leave
// the escape scan looking at an empty import map.

external fn sort_pair(mut p: Pair);
use { sort_pair } from sortlib;

struct Pair {
    a: i32;
    b: i32;

    fn touch(mut self) -> i32 {
        sort_pair(self);
        return self.a * 1000 + self.b;
    }
}

pub fn run() -> i32 {
    let p: Pair = Pair { a: 5, b: 2 };
    return p.touch() * 100 + p.a * 10 + p.b;
}
