pub fn factorial_i64(n: i64) -> i64 {
    let one: i64 = 1;
    if n <= one {
        return one;
    }
    let mut result: i64 = 1;
    let mut i: i64 = 2;
    loop i <= n {
        result = result * i;
        i = i + one;
    }
    return result;
}

pub fn fibonacci_i64(n: i64) -> i64 {
    let zero: i64 = 0;
    let one: i64 = 1;
    if n <= zero {
        return zero;
    }
    if n == one {
        return one;
    }
    let mut a: i64 = 0;
    let mut b: i64 = 1;
    let mut i: i64 = 2;
    loop i <= n {
        let next: i64 = a + b;
        a = b;
        b = next;
        i = i + one;
    }
    return b;
}

pub fn gcd_i64(a: i64, b: i64) -> i64 {
    let zero: i64 = 0;
    let mut x: i64 = a;
    let mut y: i64 = b;
    if x < zero {
        x = zero - x;
    }
    if y < zero {
        y = zero - y;
    }
    loop y > zero {
        let t: i64 = y;
        y = x % y;
        x = t;
    }
    return x;
}

pub fn lcm_i64(a: i64, b: i64) -> i64 {
    let zero: i64 = 0;
    if a == zero {
        return zero;
    }
    if b == zero {
        return zero;
    }
    let g: i64 = gcd_i64(a, b);
    return (a / g) * b;
}

pub fn is_even(n: i32) -> bool {
    return (n & 1) == 0;
}

pub fn is_odd(n: i32) -> bool {
    return (n & 1) == 1;
}

fn abs_i64(x: i64) -> i64 {
    let zero: i64 = 0;
    if x < zero {
        return -x;
    }
    return x;
}

pub fn sum_range_i64(n: i64) -> i64 {
    let zero: i64 = 0;
    let one: i64 = 1;
    if n <= zero {
        return zero;
    }
    let mut result: i64 = 0;
    let mut i: i64 = 1;
    if i <= n {
        result = result + i;
        i = i + one;
        if i <= n {
            result = result + i;
            i = i + one;
            if i <= n {
                result = result + i;
                i = i + one;
                if i <= n {
                    result = result + i;
                    i = i + one;
                    if i <= n {
                        result = result + i;
                    }
                }
            }
        }
    }
    return result;
}
