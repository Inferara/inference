fn abs_i32(x: i32) -> i32 {
    if x < 0 {
        return -x;
    }
    return x;
}

pub fn factorial(n: i32) -> i32 {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

pub fn fibonacci(n: i32) -> i32 {
    if n <= 0 {
        return 0;
    }
    if n == 1 {
        return 1;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

pub fn gcd(a: i32, b: i32) -> i32 {
    if b == 0 {
        return abs_i32(a);
    }
    return gcd(b, a % b);
}

pub fn power(base: i32, exp: i32) -> i32 {
    if exp <= 0 {
        return 1;
    }
    if (exp % 2) == 0 {
        let half: i32 = power(base, exp / 2);
        return half * half;
    }
    return base * power(base, exp - 1);
}

pub fn digit_sum(n: i32) -> i32 {
    let a: i32 = abs_i32(n);
    if a < 10 {
        return a;
    }
    return (a % 10) + digit_sum(a / 10);
}

pub fn digit_count(n: i32) -> i32 {
    let a: i32 = abs_i32(n);
    if a < 10 {
        return 1;
    }
    return 1 + digit_count(a / 10);
}
