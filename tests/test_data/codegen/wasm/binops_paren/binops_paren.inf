pub fn paren_override_precedence(a: i32, b: i32, c: i32) -> i32 { return (a + b) * c; }
pub fn paren_vs_no_paren_add_mul(a: i32, b: i32, c: i32) -> i32 { return a + (b * c); }
pub fn deep_nested_3(a: i32, b: i32, c: i32) -> i32 { return ((a + b) + c); }
pub fn deep_nested_4(a: i32, b: i32, c: i32, d: i32) -> i32 { return (((a + b) + c) + d); }
pub fn paren_sub_chain(a: i32, b: i32, c: i32) -> i32 { return a - (b - c); }
pub fn paren_div_chain(a: i32, b: i32, c: i32) -> i32 { return a / (b / c); }
pub fn paren_mixed_arith(a: i32, b: i32, c: i32, d: i32) -> i32 { return (a + b) * (c - d); }
pub fn paren_compare_sum(a: i32, b: i32, c: i32) -> bool { return (a + b) > c; }
pub fn paren_bool_complex(a: i32, b: i32, c: i32, d: i32) -> bool { return (a > b) == (c < d); }
pub fn paren_bitwise_chain(a: i32, b: i32, c: i32) -> i32 { return (a | b) & c; }
pub fn paren_shift_arith(a: i32, b: i32) -> i32 { return (a + 1) << b; }
pub fn paren_negated_sum(a: i32, b: i32) -> i32 { return -(a + b); }
pub fn paren_bitnot_masked(a: i32, b: i32) -> i32 { return (~a) & b; }
pub fn paren_not_cmp(a: i32, b: i32) -> bool { return !(a == b); }
pub fn nested_parens_deep(a: i32) -> i32 { return ((((a + 1) + 1) + 1) + 1); }
pub fn paren_with_let(a: i32, b: i32, c: i32) -> i32 { let x: i32 = (a + b) * c; return x; }
pub fn paren_compare_complex(a: i32, b: i32, c: i32) -> bool { return (a + b) >= (c * 2); }
