// Proof-mode byte golden for the `unique`-kind reachability lowering: the
// same vanilla-body, choice-suffix lowering as the exists golden, carried as
// a unique-kind `inference.hspecs` v2 entry. The single choice is NAMED —
// `unique` compares source-visible exit states, so the choice must have a
// visible-locs slot (an anonymous `@` in a `unique` body is rejected as
// P012) — and the `assume` pins it to `parity(seed)`, so exactly one choice
// survives per entry value: the shape `ValidUniqueSpec` states.
//
// The claim after the filter has to hold at every entry, because the judgment
// quantifies `seed` universally: `bit` is in {-1, 0, 1}, and the cube is the
// identity on all three (the square is not — it sends -1 to 1, which would
// make the claim false at every negative odd `seed`). The `wrapping(...)`
// spelling keeps the arithmetic modular in the program that ships: a retained
// body is reduced as written, and a choice that trapped would shrink the
// successful set instead of narrowing the claim.
fn parity(n: i32) -> i32 {
    return n % 2;
}

spec ReachUnique {
    fn uq_choice(seed: i32) unique {
        let bit: i32 = @;
        assume {
            assert(bit == parity(seed));
        }
        assert(wrapping(bit * bit * bit) == bit);
    }
}

pub fn main() {}
