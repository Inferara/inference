// Proof-mode byte golden for the `exists`-kind reachability lowering: the
// spec function's declared parameter is followed by its hidden trailing
// choice parameters (i32, i64, i32 — the named `n`/`wide` and the anonymous
// call argument), so the module's TYPE section carries the suffix nothing
// else byte-pins. The body lowers vanilla (no 0xfc wrapper, filters as
// trap-on-false) and the obligation travels as an exists-kind
// `inference.hspecs` v2 entry whose visible locs name the entry parameter
// and the two named choices only.
//
// The doubling is modular by construction and spelled `wrapping(...)` to keep
// it so in the program that ships: this body is retained, which means a
// reachability judgment reduces it and everything it calls, and an operator
// that could leave its type would empty the observation set at the entries
// where it does rather than narrow the claim.
fn double(n: i32) -> i32 {
    return wrapping(n + n);
}

spec ReachExists {
    fn ex_choice(lo: i32) exists {
        let n: i32 = @;
        assume {
            assert(n > lo);
        }
        let wide: i64 = @;
        assume {
            assert(wide >= 0);
        }
        assert(double(n) == wrapping(n + n));
        assert(double(@) >= lo);
    }
}

pub fn main() {}
