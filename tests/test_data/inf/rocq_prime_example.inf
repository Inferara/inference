// The canonical wasm-verifier PrimeExample, expressed in Inference: a faithful
// executable `is_prime` (the `T_app` target of the spec obligation) paired with
// the `forall` spec whose obligation reproduces `prime_hspec1`
// (from wasm-verifier's `theories/examples/PrimeExample.v`) node for node under
// one added antecedent, the upper bound on `n` below.
// `rocq_prime_bounded_example.inf` states the same two antecedents in the same
// order and differs from this fixture only in that bound's constant, which is
// what keeps the two a controlled pair.
//
// `is_prime` is written without a return inside the loop (analysis rule A003):
// it seeds a `result` flag, then clears it on finding any divisor. The loop's
// `i * i <= n` bound keeps it a real trial-division primality test rather than a
// stub, and its body survives in the module record as defined-fn index 0 — which
// is why the obligation's cross-call prints as `T_app 0`.
//
// The else-arm existential binder is named `k`, not `m`: two `let m` in one
// function would share a WASM local slot (analysis rule A041 forbids the reuse),
// and binder names never reach the obligation IR, so the tree is identical to
// PrimeExample's — the then-arm `m` is a `T_local` slot, the else-arm binder a
// `T_lvar` introduced by `HA_ex`.
fn is_prime(n: i32) -> bool {
    if n < 2 {
        return false;
    }
    let mut result: bool = true;
    let mut i: i32 = 2;
    loop i * i <= n {
        if (n % i) == 0 {
            result = false;
        }
        i = i + 1;
    }
    return result;
}

spec prime_properties {
    fn prime_spec() forall {
        let n: i32 = @;
        // Trial division squares every `i` up to `floor(sqrt(n)) + 1`, so
        // 2147395599 is the largest argument whose test stays inside `i32`:
        // there `i` reaches 46340 and `46340 * 46340` is 2147395600. At
        // 2147395600 the loop reaches 46341 and `46341 * 46341` is 2147488281,
        // past the type — the concrete argument at which the claim below is
        // false without this bound. `i + 1` cannot leave the type under it.
        assume { assert(n <= 2147395599); }
        assume { assert(n > 1); }
        if is_prime(n) {
            let m: i32 = @;
            assume { assert(m > 1 && m < n); }
            assert(n % m > 0);
        } else exists {
            let k: i32 = @;
            assume { assert(k > 1 && k < n); }
            assert(n % k == 0);
        }
    }
}
