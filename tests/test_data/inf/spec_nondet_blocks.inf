// Inline non-deterministic blocks (`forall`/`exists`/`assume`) inside spec
// functions. In proof mode every spec-function body is lowered, so this fixture
// keeps the inline-block (`lower_block`) lowering path covered:
//   forall  -> 0xfc 0x3a
//   exists  -> 0xfc 0x3b
//   assume  -> 0xfc 0x3c
//   uzumaki -> 0xfc 0x31
// The spec bodies themselves are omitted from the `.v`, so those opcodes are
// asserted on the WASM bytes rather than on any emitted constructor.
// This is the spec-wrapped, analysis-legal counterpart of the negative fixture
// `nondet_blocks.inf`.
//
// Every function claims something: an `assume` with nothing after it folds to
// `Imp(p, ⊤) = ⊤`, which is the vacuous obligation `P010` rejects, so the filter
// is followed by the property it guards.
spec NondetBlocks {
  fn forall_fn() {
    forall {
      let x: i32 = @;
      assert(x == x);
    }
  }
  fn exists_fn() {
    exists {
      let y: i32 = @;
      assert(y == y);
    }
  }
  fn assume_fn() {
    forall {
      let z: i32 = @;
      assume {
        assert(z != 0);
      }
      assert(z > 0 || z < 0);
    }
  }
}
