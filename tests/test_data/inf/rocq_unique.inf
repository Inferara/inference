// Negative proof-mode fixture: a nested `unique` BLOCK inside an
// `exists`-quantified spec-function body. That function's obligation is a
// judgment about one run of its body, which cannot single out one stretch of
// the run as unique, so proof-mode codegen rejects the spec with a fatal
// `P002` diagnostic before any artifact is written. The same block inside a
// `forall` or plain spec function translates (see spec_unique_blocks.inf),
// and a `unique`-quantified spec-function BODY (`fn f() unique { … }`) is
// reachability-lowered and emits a `ValidUniqueSpec` obligation (see
// rocq_unique_spec.inf). Compile mode is unaffected (specs are stripped from
// codegen). Pinned by `a_unique_block_inside_a_reachability_body_names_the_remedy`
// in core/wasm-codegen/src/hassert/tests.rs.
spec UniqueSpec {
    fn unique_fn() exists {
        let k: i32 = @;
        unique {
            let x: i32 = @;
            assert(x == k);
        }
    }
}
