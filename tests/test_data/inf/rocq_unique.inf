// Negative proof-mode fixture: the `unique` non-deterministic block has no
// honest Rocq lowering — the wasm-verifier library defines no `BI_unique`
// constructor — so proof mode (`-v`) rejects it with a recoverable
// `UnsupportedFeature` error instead of emitting a `.v` that could never
// type-check against the real library. Compile mode is unaffected (specs are
// stripped from codegen). The `unique` block lives inside a `spec` because
// non-deterministic constructs are valid only there (analysis rule A042).
// Pinned by `unique_block_is_rejected_in_proof_mode` in
// tests/src/rocq_typecheck.rs.
spec UniqueSpec {
    fn unique_fn() {
        unique {
            let x: i32 = @;
            assert(x == x);
        }
    }
}
