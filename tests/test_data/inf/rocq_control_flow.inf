// Exercises the structured-control-flow surface of proof-mode Rocq lowering:
// `loop` (BI_block + BI_loop + BI_br/BI_br_if), `if` (BI_if with two arms),
// integer comparisons and arithmetic (BI_relop / BI_binop / BI_testop), and a
// cross-function call (BI_call). The `spec` block adds a `forall` body modifier
// so the module also surfaces a per-spec `ValidModule` theorem.
fn sum_to(n: i32) -> i32 {
    let mut acc: i32 = 0;
    let mut i: i32 = 1;
    loop i <= n {
        if (i % 2) == 0 {
            acc = acc + i;
        }
        i = i + 1;
    }
    return acc;
}

pub fn main() -> i32 {
    return sum_to(10);
}

spec SumSpec {
    fn sum_prop() forall {
        let n: i32 = @;
        // `sum_to` accumulates only the even `i`, so its result is
        // `k * (k + 1)` with `k = floor(n / 2)`. At 92681 that is
        // `46340 * 46341` = 2147441940, inside `i32`; at 92682 it is
        // `46341 * 46342` = 2147534622, past it — the concrete argument at
        // which the claim below is false without this bound. No lower bound is
        // needed, since the loop never runs below 1.
        assume {
            assert(n <= 92681);
        }
        assert(sum_to(n) == sum_to(n));
    }
}
