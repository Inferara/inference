// Negative analysis fixture: inline non-deterministic blocks (`forall`,
// `exists`, `assume`) in plain top-level functions — lexically OUTSIDE any
// `spec` declaration. Non-deterministic constructs describe specifications and
// are valid only inside a `spec`, so analysis rejects every block here with
// A042 (one diagnostic per block). The spec-wrapped counterpart that exercises
// the same proof-mode lowering lives in `spec_nondet_blocks.inf`.
pub fn forall_fn() {
    forall {
        let x: i32 = @;
        assert(x == x);
    }
}

pub fn exists_fn() {
    exists {
        let y: i32 = @;
        assert(y == y);
    }
}

pub fn assume_fn() {
    assume {
        let z: i32 = @;
        assert(z == z);
    }
}
