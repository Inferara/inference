// Integer literals inside a `spec` body take their type from the position they
// appear in, exactly as they do in executable code — one traversal types both,
// so the specification and the program it constrains agree on what a constant
// denotes.
//
// The literals this fixture turns on — 4294967296 and u64::MAX — are larger than
// `i32::MAX`, so neither could be written at all under an `i32` default: the
// return, argument and operand positions are what make them `i64`/`u64`, and the
// emitted obligation carries them as `Vi64` values.
fn scaled(n: i64) -> i64 {
    return n * 2;
}

fn nonzero(n: u64) -> bool {
    return n > 0;
}

// Return position: the declared return type is what types the literal. The
// specification below applies this function, so the constant the return position
// typed is what the obligation compares against.
fn threshold() -> i64 {
    return 4294967296;
}

pub fn main() -> i64 {
    return scaled(4294967296);
}

spec LiteralPositions {
    fn threshold_is_i64() forall {
        // Peer position against an `i64`-returning application.
        assert(threshold() == 4294967296);
    }

    fn scaled_grows() forall {
        let n: i64 = @;
        // Peer position: `n` is `i64`, so the operand it is compared against is.
        assume {
            assert(n > 4294967296);
        }
        // Operand position under `i64` arithmetic, and argument position at a
        // `u64` parameter, which is what makes `u64::MAX` expressible.
        assert(scaled(n) > n + 1);
        assert(nonzero(18446744073709551615));
    }
}
