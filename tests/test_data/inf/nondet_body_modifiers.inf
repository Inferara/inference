// Negative analysis fixture: function-body non-deterministic *modifiers*
// (`fn f() forall { … }`), which record the kind on the function's body block,
// placed on plain top-level functions — lexically OUTSIDE any `spec`. Analysis
// rejects each with A042. The spec-wrapped counterpart that exercises the same
// modifier lowering path in proof mode lives in `spec_nondet_body_modifiers.inf`.
fn forall_fn() forall {
    let x: i32 = @;
    assert(x == x);
}

fn exists_fn() exists {
    let y: i32 = @;
    assert(y == y);
}

fn assume_fn() assume {
    let z: i32 = @;
    assert(z == z);
}
