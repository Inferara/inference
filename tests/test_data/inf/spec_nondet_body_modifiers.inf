// Function-body non-deterministic MODIFIERS (`fn f() forall { … }`) inside spec
// functions. A modifier records its kind on the function's body block, lowered
// by a different codegen path (`visit_function_definition_body`) than an inline
// block. In proof mode every spec-function body is lowered, so keeping this
// covered pins the wrapper arity for `exists`/`assume`, not just `forall`.
// This is the spec-wrapped, analysis-legal counterpart of the negative fixture
// `nondet_body_modifiers.inf`.
spec NondetBodyModifiers {
  fn forall_fn() forall {
    let x: i32 = @;
    assert(x == x);
  }
  fn exists_fn() exists {
    let y: i32 = @;
    assert(y == y);
  }
  fn assume_fn() assume {
    let z: i32 = @;
    assert(z == z);
  }
}
