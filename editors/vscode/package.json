{
  "name": "inference",
  "displayName": "Inference",
  "description": "Language support for Inference - a programming language for verified WebAssembly - and proof jobs on the Inference proof server",
  "version": "0.0.6",
  "publisher": "inference-lang",
  "license": "GPL-3.0",
  "icon": "icons/inference.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Inferara/inference"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "inference",
    "webassembly",
    "wasm",
    "rocq",
    "coq",
    "formal-verification"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.inf",
    "onLanguage:inference",
    "onView:inference.configView",
    "onView:inference.proofJobsView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "inference",
          "title": "Inference",
          "icon": "icons/file_icon.svg"
        }
      ]
    },
    "views": {
      "inference": [
        {
          "id": "inference.configView",
          "name": "Configuration",
          "icon": "icons/file_icon.svg"
        },
        {
          "id": "inference.proofJobsView",
          "name": "Proof Jobs",
          "icon": "icons/file_icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "inference.configView",
        "contents": "Inference toolchain is not installed.\n[Install Toolchain](command:inference.installToolchain)\n[Configure Path](command:workbench.action.openSettings?%5B%22inference.path%22%5D)",
        "when": "!inference.toolchainInstalled"
      },
      {
        "view": "inference.proofJobsView",
        "contents": "Prove the specifications in your Inference code with the Inference proof server.\n[Set API Key](command:inference.setProverApiKey)\nYour proof-server operator issues the key. [Proof server settings](command:workbench.action.openSettings?%5B%22inference.prover.serverUrl%22%5D)",
        "when": "!inference.prover.configured"
      }
    ],
    "languages": [
      {
        "id": "inference",
        "aliases": [
          "Inference",
          "inference",
          "inf"
        ],
        "extensions": [
          ".inf"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/file_icon.svg",
          "dark": "./icons/file_icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "inference",
        "scopeName": "source.inference",
        "path": "./syntaxes/inference.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "inference.installToolchain",
        "title": "Inference: Install Toolchain"
      },
      {
        "command": "inference.installComponent",
        "title": "Inference: Install Component (wasm-opt)"
      },
      {
        "command": "inference.updateToolchain",
        "title": "Inference: Update Toolchain"
      },
      {
        "command": "inference.selectVersion",
        "title": "Inference: Select Toolchain Version"
      },
      {
        "command": "inference.runDoctor",
        "title": "Inference: Run Doctor"
      },
      {
        "command": "inference.restartLsp",
        "title": "Inference: Restart Language Server"
      },
      {
        "command": "inference.showOutput",
        "title": "Inference: Show Output"
      },
      {
        "command": "inference.resetPathAcceptance",
        "title": "Inference: Reset PATH Fallback Preference"
      },
      {
        "command": "inference.refreshConfigView",
        "title": "Inference: Refresh Configuration",
        "icon": "$(refresh)"
      },
      {
        "command": "inference.copyConfigValue",
        "title": "Copy Value"
      },
      {
        "command": "inference.revealConfigPath",
        "title": "Reveal in File Explorer"
      },
      {
        "command": "inference.proveFile",
        "title": "Inference: Prove This File",
        "icon": "$(verified)"
      },
      {
        "command": "inference.submitProof",
        "title": "Inference: Submit Rocq File for Proof",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "inference.setProverApiKey",
        "title": "Inference: Set Proof Server API Key"
      },
      {
        "command": "inference.clearProverApiKey",
        "title": "Inference: Clear Proof Server API Key"
      },
      {
        "command": "inference.refreshProofJobs",
        "title": "Inference: Refresh Proof Jobs",
        "icon": "$(refresh)"
      },
      {
        "command": "inference.filterProofJobs",
        "title": "Inference: Filter Proof Jobs by Status",
        "icon": "$(filter)"
      },
      {
        "command": "inference.openProofJob",
        "title": "Open Proof Job"
      },
      {
        "command": "inference.cancelProofJob",
        "title": "Cancel Proof Job",
        "icon": "$(stop-circle)"
      },
      {
        "command": "inference.deleteProofJob",
        "title": "Delete Proof Job",
        "icon": "$(trash)"
      },
      {
        "command": "inference.resubmitProofJob",
        "title": "Run Proof Job Again",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "inference.copyProofJobId",
        "title": "Copy Job ID"
      },
      {
        "command": "inference.compareProof",
        "title": "Compare Completed Proof with Input",
        "icon": "$(diff)"
      },
      {
        "command": "inference.openProofJobInPortal",
        "title": "Open Certificate in Portal",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "inference.refreshConfigView",
          "when": "view == inference.configView",
          "group": "navigation"
        },
        {
          "command": "inference.filterProofJobs",
          "when": "view == inference.proofJobsView",
          "group": "navigation@1"
        },
        {
          "command": "inference.refreshProofJobs",
          "when": "view == inference.proofJobsView",
          "group": "navigation@2"
        },
        {
          "command": "inference.submitProof",
          "when": "view == inference.proofJobsView",
          "group": "1_submit"
        }
      ],
      "view/item/context": [
        {
          "command": "inference.copyConfigValue",
          "when": "view == inference.configView && viewItem == inference.configPath",
          "group": "inline"
        },
        {
          "command": "inference.revealConfigPath",
          "when": "view == inference.configView && viewItem == inference.configPath"
        },
        {
          "command": "inference.cancelProofJob",
          "when": "view == inference.proofJobsView && viewItem =~ /\\.cancelable/",
          "group": "inline"
        },
        {
          "command": "inference.compareProof",
          "when": "view == inference.proofJobsView && viewItem =~ /\\.proof$/",
          "group": "1_review@1"
        },
        {
          "command": "inference.openProofJobInPortal",
          "when": "view == inference.proofJobsView && viewItem =~ /\\.terminal/",
          "group": "1_review@2"
        },
        {
          "command": "inference.copyProofJobId",
          "when": "view == inference.proofJobsView && viewItem =~ /^inference\\.proofJob/",
          "group": "1_review@3"
        },
        {
          "command": "inference.resubmitProofJob",
          "when": "view == inference.proofJobsView && viewItem =~ /\\.terminal/",
          "group": "2_manage@1"
        },
        {
          "command": "inference.cancelProofJob",
          "when": "view == inference.proofJobsView && viewItem =~ /\\.cancelable/",
          "group": "2_manage@2"
        },
        {
          "command": "inference.deleteProofJob",
          "when": "view == inference.proofJobsView && viewItem =~ /\\.terminal/",
          "group": "2_manage@3"
        }
      ],
      "editor/title": [
        {
          "command": "inference.proveFile",
          "when": "resourceExtname == .inf",
          "group": "navigation"
        },
        {
          "command": "inference.submitProof",
          "when": "resourceExtname == .v",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "inference.proveFile",
          "when": "resourceExtname == .inf",
          "group": "z_commands"
        },
        {
          "command": "inference.submitProof",
          "when": "resourceExtname == .v",
          "group": "z_commands"
        }
      ],
      "explorer/context": [
        {
          "command": "inference.proveFile",
          "when": "resourceExtname == .inf",
          "group": "z_commands"
        },
        {
          "command": "inference.submitProof",
          "when": "resourceExtname == .v",
          "group": "z_commands"
        }
      ],
      "commandPalette": [
        {
          "command": "inference.openProofJob",
          "when": "false"
        },
        {
          "command": "inference.cancelProofJob",
          "when": "false"
        },
        {
          "command": "inference.deleteProofJob",
          "when": "false"
        },
        {
          "command": "inference.resubmitProofJob",
          "when": "false"
        },
        {
          "command": "inference.copyProofJobId",
          "when": "false"
        },
        {
          "command": "inference.compareProof",
          "when": "false"
        },
        {
          "command": "inference.openProofJobInPortal",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Inference",
      "properties": {
        "inference.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to infs binary. Leave empty for auto-detection."
        },
        "inference.autoInstall": {
          "type": "boolean",
          "default": true,
          "description": "Prompt to install toolchain if not found."
        },
        "inference.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Check for toolchain updates on activation."
        },
        "inference.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the Inference language server (inference-lsp) automatically. Provides diagnostics, hover, go to definition, completions, and more."
        },
        "inference.lsp.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the inference-lsp binary. Leave empty for auto-detection (INFERENCE_HOME/bin, then PATH). If set but not executable, the language server is not started."
        },
        "inference-lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Trace the communication between VS Code and the Inference language server in the 'Inference Language Server' output channel."
        },
        "inference.prover.serverUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Proof server for **Prove This File** and the Proof Jobs view. Leave empty for the hosted Inference proof service. Must use `https`; plain `http` is accepted only for `localhost` (for example an offline local deployment)."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "inference.gettingStarted",
        "title": "Get Started with Inference",
        "description": "Set up the Inference toolchain and build your first verified program.",
        "featuredFor": [
          "**/*.inf"
        ],
        "steps": [
          {
            "id": "inference.walkthrough.install",
            "title": "Install the Toolchain",
            "description": "The Inference toolchain provides the compiler, verifier, and project tools.\n\n[Install Toolchain](command:inference.installToolchain)\n\nAlternatively, [download manually](https://github.com/Inferara/inference/releases) or [configure a custom path](command:workbench.action.openSettings?%5B%22inference.path%22%5D).",
            "media": {
              "image": "icons/inference.png",
              "altText": "Inference logo"
            },
            "completionEvents": [
              "onCommand:inference.installToolchain"
            ]
          },
          {
            "id": "inference.walkthrough.verify",
            "title": "Verify Your Installation",
            "description": "Run the built-in doctor to check that all toolchain components are working correctly.\n\n[Run Doctor](command:inference.runDoctor)\n\nThe status bar at the bottom of VS Code shows toolchain health at a glance.",
            "media": {
              "image": "icons/inference.png",
              "altText": "Inference logo"
            },
            "completionEvents": [
              "onCommand:inference.runDoctor"
            ]
          },
          {
            "id": "inference.walkthrough.createProject",
            "title": "Create a Project",
            "description": "Create a new file and save it with the `.inf` extension to start writing Inference code. Syntax highlighting, bracket matching, and code folding work right away; language-server features (diagnostics, hover, go to definition) activate once the file is saved on disk.\n\n[Create New File](command:workbench.action.files.newUntitledFile)",
            "media": {
              "image": "icons/inference.png",
              "altText": "Inference logo"
            },
            "completionEvents": [
              "onLanguage:inference"
            ]
          },
          {
            "id": "inference.walkthrough.build",
            "title": "Build Your Program",
            "description": "Use the integrated terminal to compile your Inference source file:\n\n```\ninfs build main.inf\n```\n\nThis produces a WebAssembly `.wasm` file. Learn more in the [Inference Book](https://github.com/Inferara/book).",
            "media": {
              "image": "icons/inference.png",
              "altText": "Inference logo"
            },
            "completionEvents": [
              "stepSelected"
            ]
          },
          {
            "id": "inference.walkthrough.prove",
            "title": "Prove Your Specifications",
            "description": "Prove the `spec` properties of your program on the Inference proof server.\n\n[Set API Key](command:inference.setProverApiKey) with the key your proof-server operator issued, then open your `.inf` file and run:\n\n[Prove This File](command:inference.proveFile)\n\nThe extension checks your compiler against the one the server accepts, compiles the file in proof mode (`infs build <file>.inf -v`), uploads the generated Rocq file and follows the job in the **Proof Jobs** view.",
            "media": {
              "image": "icons/inference.png",
              "altText": "Inference logo"
            },
            "completionEvents": [
              "onCommand:inference.proveFile"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "vscode:prepublish": "npm run build:prod",
    "watch": "node esbuild.mjs --watch",
    "test": "node --import tsx --test src/test/**/*.test.ts",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish",
    "test syntax": "tsx --test test/grammar.test.ts test/language-config.test.ts"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
